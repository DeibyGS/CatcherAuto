                android:layout_height="1dp"
                android:background="@color/cyan_accent"
                android:alpha="0.35"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  PERMISOS DEL SISTEMA  "
                android:textColor="@color/cyan_accent"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:letterSpacing="0.3"
                android:alpha="0.55"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:background="@color/cyan_accent"
                android:alpha="0.35"/>
        </LinearLayout>

        <!-- Permiso 01: Accesibilidad -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/btnEnable"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/surface"
            app:strokeColor="@color/border_inactive"
            app:strokeWidth="1dp"
            app:cardCornerRadius="10dp"
            app:cardElevation="0dp"
            android:layout_marginBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:text="01"
                    android:textColor="@color/cyan_accent"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace"
                    android:gravity="center"
                    android:background="@drawable/bg_number_badge"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Accesibilidad"
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Detectar y pulsar botones"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/cyan_accent"
                    android:textSize="22sp"
                    android:alpha="0.45"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <!-- Permiso 03 eliminado — overlay ya no es necesario -->

