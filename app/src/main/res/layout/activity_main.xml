<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingBottom="40dp">

        <!-- ══════════════════════════════════════ -->
        <!--  HEADER                                -->
        <!-- ══════════════════════════════════════ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="28dp">

            <View
                android:layout_width="3dp"
                android:layout_height="52dp"
                android:background="@color/cyan_accent"
                android:layout_marginEnd="14dp"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CATCHER"
                    android:textColor="@color/cyan_accent"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.3"
                    android:alpha="0.85"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AUTO"
                    android:textColor="@color/text_primary"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08"
                    android:layout_marginTop="-4dp"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="end">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RIDER"
                    android:textColor="@color/cyan_accent"
                    android:textSize="9sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.3"
                    android:alpha="0.55"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="MODE"
                    android:textColor="@color/cyan_accent"
                    android:textSize="9sp"
                    android:fontFamily="monospace"
                    android:letterSpacing="0.3"
                    android:alpha="0.55"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ══════════════════════════════════════ -->
        <!--  STATUS CARD con pulso animado         -->
        <!-- ══════════════════════════════════════ -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface"
            app:strokeColor="@color/cyan_accent"
            app:strokeWidth="1dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            android:layout_marginBottom="32dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingVertical="28dp"
                android:paddingHorizontal="24dp">

                <View
                    android:id="@+id/pulseRing"
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_pulse_ring"
                    android:alpha="0"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center">

                    <TextView
                        android:id="@+id/tvStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="COMPROBANDO..."
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:gravity="center"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.05"/>

                    <View
                        android:layout_width="48dp"
                        android:layout_height="1dp"
                        android:background="@color/border_inactive"
                        android:layout_marginTop="14dp"
                        android:layout_marginBottom="14dp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FUENLABRADA  ·  MAX 3.0 KM"
                        android:textColor="@color/cyan_accent"
                        android:textSize="9sp"
                        android:fontFamily="monospace"
                        android:letterSpacing="0.2"
                        android:alpha="0.5"/>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/btnToggleEscaneo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginTop="20dp"
                        app:cardBackgroundColor="#FF1B2A1B"
                        app:strokeColor="@color/cyan_accent"
                        app:strokeWidth="1dp"
                        app:cardCornerRadius="8dp"
                        app:cardElevation="0dp">

                        <TextView
                            android:id="@+id/tvToggleLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="⏸  PAUSAR ESCANEO"
                            android:textColor="@color/cyan_accent"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:fontFamily="monospace"
                            android:letterSpacing="0.1"
                            android:paddingHorizontal="24dp"
                            android:paddingVertical="12dp"/>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ══════════════════════════════════════ -->
        <!--  SECTION: PERMISOS DEL SISTEMA         -->
        <!-- ══════════════════════════════════════ -->
        <LinearLayout
